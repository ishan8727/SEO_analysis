{
  "name": "seo-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "tsup",
    "start": "next start",
    "start:app": "tsx scripts/start-app.ts",
    "worker": "node dist-worker/index.mjs",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "queue:ping": "tsx --env-file-if-exists=.env scripts/ping.ts",
    "moli:smoke": "tsx --env-file-if-exists=.env scripts/moli-smoke.ts",
    "scan:run": "tsx --env-file-if-exists=.env scripts/run-scan.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "pdf:smoke": "tsx --env-file-if-exists=.env scripts/pdf-smoke.ts",
    "lead:test": "tsx --env-file-if-exists=.env scripts/lead-webhook-test.ts",
    "icons:build": "tsx scripts/make-icons.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.30.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.4.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright-core": "^1.64.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/google.maps": "^3.66.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
