# Edge site for seo-audit on the shared VM. scripts/deploy.sh copies it to /opt/edge/sites/ and reloads Caddy,
# which gets and renews the Let's Encrypt certificate by itself (DNS must point at the VM, not a proxy).
audit.thesalesinc.com {
	encode zstd gzip
	reverse_proxy seo-audit-web:3000 {
		# Overwrite whatever the client sent: getClientIp() trusts X-Real-IP for rate limits.
		header_up X-Real-IP {remote_host}
	}
}
