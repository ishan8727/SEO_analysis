# Non-secret production config for seo-audit. deploy/vm-deploy.sh writes these into /opt/apps/seo-audit/.env
# together with the secrets from Secret Manager (seo-audit-*). Public build values (NEXT_PUBLIC_*) are
# baked into the image from .env.deploy, not read here.
NODE_ENV=production
APP_URL=https://audit.example.com
FIREBASE_PROJECT_ID=your-gcp-project
GEMINI_MODEL=gemini-3.5-flash-lite
SCAN_CACHE_DAYS=7
DEFAULT_COUNTRY=IN
ONLINE_MODE=on
WORKER_CONCURRENCY=4
LOG_LEVEL=info
CRM_ENABLED=false
