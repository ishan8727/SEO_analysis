// Source of truth: SPEC.md section 7. Phase 1 changes are listed in SPEC.md section 14.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  queued
  running
  done
  failed
}

enum ScanMode {
  local
  online
}

enum LeadRole {
  owner
  founder
  marketing
  agency
  other
}

model Business {
  id          String   @id @default(cuid())
  placeId     String?  @unique
  mode        ScanMode
  name        String
  websiteUrl  String?
  address     String?
  lat         Float?
  lng         Float?
  primaryType String?
  scans       Scan[]
  createdAt   DateTime @default(now())
}

model Scan {
  id              String     @id // nanoid(21), unguessable
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  status          ScanStatus @default(queued)
  progress        Json       @default("{}") // ScanProgress in src/types.ts
  placeSnapshot   Json? // PlaceSnapshot; Google data, purged after 30 days
  gbp             Json? // GbpResult
  competitors     Json? // CompetitorsResult
  psi             Json? // PsiResult
  domAudit        Json? // DomAuditResult
  sentiment       Json? // SentimentResult
  score           Json? // ScoreResult
  error           String? // user-safe message when status = failed
  ipHash          String
  createdAt       DateTime   @default(now())
  finishedAt      DateTime?
  snapshotPurgeAt DateTime?
  leads           Lead[]
  assets          Asset[]

  @@index([businessId, createdAt])
  @@index([snapshotPurgeAt])
}

// Screenshots and PDFs. Stored in Postgres so web (serves) and worker (writes) share them
// and one pg_dump backs up everything.
model Asset {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  kind      String // AssetKind in src/types.ts
  mime      String
  bytes     Bytes
  createdAt DateTime @default(now())

  @@unique([scanId, kind])
  @@index([createdAt])
}

model Lead {
  id          String    @id @default(cuid())
  scanId      String
  scan        Scan      @relation(fields: [scanId], references: [id])
  phoneE164   String // from a verified Firebase phone ID token; never logged
  countryCode String? // ISO country of the phone number
  role        LeadRole
  verifiedAt  DateTime?
  channel     String // "firebase_sms"
  firebaseUid String?
  crmSyncedAt DateTime? // CRM push is deferred; null until then
  createdAt   DateTime  @default(now())

  @@unique([scanId, phoneE164])
  @@index([phoneE164])
}
