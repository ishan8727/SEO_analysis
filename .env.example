# .env.example — copy to .env, never commit .env
# Values below are for running Next/worker on the host against docker-compose.dev.yml.
# Inside compose, DATABASE_URL / REDIS_URL / MOLI_URL are overridden in docker-compose.yml.
DATABASE_URL=postgresql://app:app@localhost:5432/seoaudit
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# Secrets — generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# HASH_SALT: 16+ chars: hashes IPs and verification codes
HASH_SALT=
# COOKIE_SECRET: 32+ chars: signs unlock cookies
COOKIE_SECRET=
# INTERNAL_TOKEN: worker → /report/[id]/print
INTERNAL_TOKEN=
# MOLI_TOKEN: 16+ chars: Moli token gate
MOLI_TOKEN=

# Google: browser key is referrer-restricted (Maps JS + Places only); server key is IP-restricted.
NEXT_PUBLIC_GOOGLE_BROWSER_KEY=
GOOGLE_SERVER_KEY=
# PSI_API_KEY: may equal GOOGLE_SERVER_KEY
PSI_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL: pin a version; Flash-Lite answers in ~1-2 s, full Flash timed out (Oct 2026)
GEMINI_MODEL=gemini-3.5-flash-lite

MOLI_URL=http://localhost:9222

# Turnstile: dev can use Cloudflare test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Firebase phone auth (Phase 5). Values from Firebase console > Project settings > General > Your apps > Web app.
# The NEXT_PUBLIC_* ones are public (they ship to the browser) and are Docker build args.
NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN: <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_PHONE_COUNTRIES: ISO codes allowed for SMS, comma-separated; must match the Firebase SMS region policy. Empty = any.
NEXT_PUBLIC_PHONE_COUNTRIES=
# Server: same project id; verifies ID tokens with firebase-admin (no service account needed).
FIREBASE_PROJECT_ID=

# INTERNAL_APP_URL: how the worker reaches the web app (PDF print page). Compose sets http://web:3000;
# Railway: http://web.railway.internal:3000 (Phase 6).
INTERNAL_APP_URL=http://localhost:3000

CRM_ENABLED=false
SCAN_CACHE_DAYS=7
# DEFAULT_COUNTRY: last-resort default for the phone gate's country code (the business's own country comes first)
DEFAULT_COUNTRY=IN
# ONLINE_MODE: on | off. Website-only audits (no Google profile)
ONLINE_MODE=on
WORKER_CONCURRENCY=4
LOG_LEVEL=debug
