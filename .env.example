# .env.example — copy to .env, never commit .env
# Values below are for running Next/worker on the host against docker-compose.dev.yml.
# Inside compose, DATABASE_URL / REDIS_URL / MOLI_URL are overridden in docker-compose.yml.
DATABASE_URL=postgresql://app:app@localhost:5432/seoaudit
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# Secrets — generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# HASH_SALT: 16+ chars: hashes IPs and verification codes
HASH_SALT=
# COOKIE_SECRET: 32+ chars: signs unlock cookies
COOKIE_SECRET=
# INTERNAL_TOKEN: worker → /report/[id]/print
INTERNAL_TOKEN=
# MOLI_TOKEN: 16+ chars: Moli token gate
MOLI_TOKEN=

# Google: browser key is referrer-restricted (Maps JS + Places only); server key is IP-restricted.
NEXT_PUBLIC_GOOGLE_BROWSER_KEY=
GOOGLE_SERVER_KEY=
# PSI_API_KEY: may equal GOOGLE_SERVER_KEY
PSI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

MOLI_URL=http://localhost:9222

# TURNSTILE_SITE_KEY: NEXT_PUBLIC_TURNSTILE_SITE_KEY is what the client reads
TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# WHATSAPP_PROVIDER: meta | interakt
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OTP_TEMPLATE=otp_login
# WHATSAPP_BUSINESS_NUMBER: for wa.me links
WHATSAPP_BUSINESS_NUMBER=91XXXXXXXXXX

CRM_ENABLED=false
SCAN_CACHE_DAYS=7
DEFAULT_COUNTRY=IN
WORKER_CONCURRENCY=4
LOG_LEVEL=debug
